# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API).
# Somente valores PÚBLICOS aqui: eles vão para o navegador e são protegidos pelo RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# NÃO coloque aqui: service_role, GEMINI_API_KEY ou qualquer segredo.
# Segredos ficam nos secrets das Edge Functions (supabase secrets set ...).
